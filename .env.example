# Copy this file to .env before starting Docker Compose.
#
# These are the only values needed before Flightmap can start. Receiver,
# display, retention, alert, and metadata options are configured in the
# running app at Settings.

# Browser access
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080
# Add every hostname or IP address users will enter, without ports.
APP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Set to true, or to a comma-separated list of proxy addresses/CIDRs, only when
# Flightmap sits behind a trusted reverse proxy. Rate limiting uses the client
# address, which is the proxy's own address unless this is configured.
APP_TRUST_PROXY=false
# Fixed-window request budgets per client address. The defaults suit interactive
# browser use; raise them only for automated suites that drive the API hard from
# a single address.
API_RATE_LIMIT=300
MUTATION_RATE_LIMIT=90
WEBSOCKET_RATE_LIMIT=30
RATE_LIMIT_WINDOW_MS=60000
# PostgreSQL
# Use a long URL-safe value because it is embedded in DATABASE_URL by Compose.
POSTGRES_PASSWORD=replace-with-a-long-random-password
