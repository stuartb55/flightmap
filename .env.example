# Copy this file to .env before starting Docker Compose.
#
# The secure default only listens on this machine. To expose Flightmap on a
# trusted LAN, set APP_BIND_ADDRESS and list every hostname/IP users will enter
# in APP_ALLOWED_HOSTS. Configure APP_ACCESS_TOKEN before LAN exposure.

# Application
APP_PORT=8080
APP_BIND_ADDRESS=127.0.0.1
APP_HOST=0.0.0.0
APP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Optional extra browser origins, including scheme and port, comma-separated.
APP_ALLOWED_ORIGINS=
# Required by production. Use at least 16 random characters; the browser
# exchanges it for an HttpOnly cookie.
APP_ACCESS_TOKEN=replace-with-a-long-random-access-token
APP_SESSION_HOURS=12
LOG_LEVEL=info
DISPLAY_TIME_ZONE=Europe/London
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark
RECEIVER_NAME=Home receiver
RANGE_RINGS_NM=5,10,25,50,100

# Receiver
RECEIVER_BASE_URL=http://192.168.1.118:81/data
POLL_INTERVAL_MS=1000
RECEIVER_TIMEOUT_MS=800
RECEIVER_INFO_INTERVAL_MS=300000
RECEIVER_STATS_INTERVAL_MS=60000
# Optional. Leave both empty to discover coordinates from receiver.json.
RECEIVER_LAT=
RECEIVER_LON=

# Collection and retention
HISTORY_RETENTION_DAYS=30
SESSION_GAP_SECONDS=300
CURRENT_AIRCRAFT_TTL_SECONDS=60
MAINTENANCE_ENABLED=true
FIRST_SEEN_ALERTS_ENABLED=true
# Avoid treating the initial population of a fresh database as first sightings.
FIRST_SEEN_ALERT_BASELINE_HOURS=24

# Aircraft metadata. This is the readsb-compatible tar1090-db CSV.
METADATA_URL=https://github.com/wiedehopf/tar1090-db/raw/csv/aircraft.csv.gz
METADATA_CHECK_INTERVAL_MS=604800000
METADATA_TIMEOUT_MS=30000
METADATA_MIN_ROWS=100000
METADATA_MAX_DOWNLOAD_BYTES=50000000
METADATA_MAX_UNCOMPRESSED_BYTES=250000000
METADATA_UPDATES_ENABLED=true

# PostgreSQL
POSTGRES_DB=flightmap
POSTGRES_USER=flightmap
POSTGRES_PASSWORD=replace-with-a-long-random-password
# Keep this in sync with the three POSTGRES_* values above. In Compose the host
# is always "db"; for host-based development change it to localhost.
DATABASE_URL=postgresql://flightmap:replace-with-a-long-random-password@db:5432/flightmap
DATABASE_POOL_MAX=20
DATABASE_SSL=false
# Optional CA bundle when DATABASE_SSL=true.
DATABASE_SSL_CA_FILE=
# Optional volume capacity used for storage percentage/health reporting.
DATABASE_VOLUME_CAPACITY_BYTES=
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=60000

# Fake receiver (only used with the optional "testing" Compose profile)
FAKE_RECEIVER_PORT=8081
FAKE_RECEIVER_LAT=53.61
FAKE_RECEIVER_LON=-2.31
FAKE_RECEIVER_AIRCRAFT_COUNT=3
