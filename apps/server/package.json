{
  "name": "@flightmap/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && cp -R src/db/migrations dist/db/",
    "typecheck": "npm run build -w @flightmap/shared --silent && tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build -w @flightmap/shared --silent",
    "test": "vitest run",
    "pretest:coverage": "npm run build -w @flightmap/shared --silent",
    "test:coverage": "vitest run --coverage",
    "pretest:integration": "npm run build -w @flightmap/shared --silent",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "db:migrate": "node dist/db/migrate-cli.js",
    "db:migrate:dev": "tsx src/db/migrate-cli.ts",
    "db:maintenance": "node dist/maintenance-cli.js",
    "db:maintenance:dev": "tsx src/maintenance-cli.ts",
    "metadata:refresh": "node dist/metadata-cli.js",
    "metadata:refresh:dev": "tsx src/metadata-cli.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.2",
    "@fastify/websocket": "^11.0.2",
    "@flightmap/shared": "*",
    "csv-parse": "^7.0.1",
    "fastify": "^5.2.1",
    "pg": "^8.13.1",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@^7.0.2",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.11.11",
    "tsx": "^4.19.2",
    "vitest": "^4.1.10"
  }
}
