    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@typescript/native": "npm:typescript@~7.0.2",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^30.0.1",
    "vite": "^8.1.5",
